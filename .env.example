# =====================================================================
# Read-Along Manager - environment configuration
#
# Copy this file to `.env` and fill in the required values.
# `.env` is git-ignored and must NEVER be committed or shared unencrypted.
# =====================================================================

# ---------------------------------------------------------------------
# AudioSilo API (required)
# ---------------------------------------------------------------------
AUDIOSILO_URL=https://your.audiosilo-server.com
AUDIOSILO_TOKEN=your_new_token_here
AUDIOSILO_LIBRARY_ID=1

# ---------------------------------------------------------------------
# Library paths
# ---------------------------------------------------------------------
# Host path scanned by the Pi (NTFS SSD)
AUDIOBOOK_ROOT=/srv/ssd/Bookshelf/Audiobooks

# Path AudioSilo sees inside its container (read-only mount)
AUDIOSILO_CONTAINER_LIBRARY=/library

# ---------------------------------------------------------------------
# Manager application directory (Pi native filesystem)
# ---------------------------------------------------------------------
MANAGER_DIR=./readalong-manager
LOGS_DIR=logs

# ---------------------------------------------------------------------
# Tracking files (resolved relative to MANAGER_DIR)
# ---------------------------------------------------------------------
POTENTIAL_FILE=potential-read-alongs.txt
NEEDS_EBOOK_FILE=needs_ebook.txt
NEEDS_ABOOK_FILE=needs_abook.txt

# ---------------------------------------------------------------------
# Batch / timing
# ---------------------------------------------------------------------
# Default number of NEW titles to queue per run
BATCH_SIZE=10
# Seconds to wait between job submissions
BATCH_DELAY=2
# HTTP request timeout in seconds
API_REQUEST_TIMEOUT=30
